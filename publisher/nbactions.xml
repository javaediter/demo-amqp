<?xml version="1.0" encoding="UTF-8"?>
<actions>
        <action>
            <actionName>rebuild</actionName>
            <packagings>
                <packaging>*</packaging>
            </packagings>
            <goals>
                <goal>clean</goal>
                <goal>install</goal>
            </goals>
            <properties>
                <Env.USER_DB>root</Env.USER_DB>
                <Env.PASWD_DB>admin</Env.PASWD_DB>
                <Env.HOST_DB>localhost</Env.HOST_DB>
                <Env.PORT_DB>3306</Env.PORT_DB>
                <Env.NAME_DB>books</Env.NAME_DB>
                <Env.URL_DB> jdbc:mysql://${HOST_DB}:${PORT_DB}/${NAME_DB}</Env.URL_DB>
                <Env.JWT_SECRET>my_secret_for_jwt_security_1234567890</Env.JWT_SECRET>
            </properties>
        </action>
        <action>
            <actionName>test</actionName>
            <packagings>
                <packaging>*</packaging>
            </packagings>
            <goals>
                <goal>test</goal>
            </goals>
